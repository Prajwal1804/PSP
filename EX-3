Title
Employee Salary Sorting using Selection Sort and Bubble Sort

Aim
Sort employee salaries in ascending order using Selection Sort and Bubble Sort, then display the top five highest salaries.
Parameters

Input: floating-point salary list. Output: sorted salaries and top five salaries. Selection Sort and Bubble Sort: O(n²) average/worst-case time; extra space O(1).

Procedure
1. Read salary values.
2. Apply Selection Sort.
3. Apply Bubble Sort.
4. Display sorted salaries.
5. Display the five highest salaries.

Program

def selection_sort(a):
    for i in range(len(a)):
        min_i = i
        for j in range(i + 1, len(a)):
            if a[j] < a[min_i]:
                min_i = j
        a[i], a[min_i] = a[min_i], a[i]
    return a

def bubble_sort(a):
    n = len(a)
    for i in range(n):
        swapped = False
        for j in range(0, n - i - 1):
            if a[j] > a[j + 1]:
                a[j], a[j + 1] = a[j + 1], a[j]
                swapped = True
        if not swapped:
            break
    return a

salaries = list(map(float, input("Enter salaries: ").split()))

s1 = selection_sort(salaries.copy())
s2 = bubble_sort(salaries.copy())

print("Selection Sort:", s1)
print("Bubble Sort:", s2)
print("Top five salaries:", s2[-5:][::-1])
